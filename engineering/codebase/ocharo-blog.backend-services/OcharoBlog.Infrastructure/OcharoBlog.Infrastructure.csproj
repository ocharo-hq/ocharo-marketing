<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kit: local blob storage (IBlobRepository), mediator handlers and AppResult. -->
    <PackageReference Include="WoW2.Sdk.Beta.Be" />
    <!-- The organization claims the image worker's final write check reads. -->
    <PackageReference Include="WoW2.Sdk.Beta.Be.Identity.Abstractions" />
    <!-- WoW2 Files' brokers, behind the media store. -->
    <PackageReference Include="WoW2.Sdk.Beta.Be.Files.Abstractions" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcharoBlog.Application\OcharoBlog.Application.csproj" />
    <ProjectReference Include="..\OcharoBlog.Domain\OcharoBlog.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OcharoBlog.Api" />
    <!-- Let the test projects reach internal handlers for direct tests. -->
    <InternalsVisibleTo Include="OcharoBlog.Tests.Unit" />
    <InternalsVisibleTo Include="OcharoBlog.Tests.Integration" />
    <InternalsVisibleTo Include="OcharoBlog.Tests.E2E" />
  </ItemGroup>

</Project>
