{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "//Database": "PostgreSQL: DatabaseSettings:ConnectionString or DB_CONNECTION, never a checked-in value.",
  "//Store": "ConnectionStrings:OcharoBlog names the SQLite store an earlier release kept; import-sqlite copies it.",
  "DatabaseSettings": {
    "ConnectionString": ""
  },
  "ConnectionStrings": {
    "OcharoBlog": "Data Source=App_Data/ocharo-blog.db"
  },
  "Blog": {
    "DataRoot": "App_Data",
    "SeedFile": "SeedData/journal-seed.json"
  }
}
