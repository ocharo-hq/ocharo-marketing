<Project>

  <!--
    Central Package Management — one version per package for the whole solution.
    Project .csproj files reference packages by name only (no Version attribute).
    https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- wow-two backend SDK (kit): mediator, Result/DomainError, IKeyedEntity, web/problem-details. On nuget.org. -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be" Version="10.0.106-beta" />
    <!-- Sign-in through Ocharo's Identity instance: the BFF (session cookie, OIDC code flow with PKCE, X-Csrf-Token). -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Identity.Client" Version="10.0.30-beta" />
    <!-- The organization claim readers Infrastructure's image worker checks; same version as the client above. -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Identity.Abstractions" Version="10.0.30-beta" />
    <!-- WoW2 Files: the contract (Infrastructure's store) and its HTTP client (the host's composition). -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Files.Abstractions" Version="10.0.5-beta" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Files.Client" Version="10.0.5-beta" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core / EF Core (.NET 10). Floors satisfy the kit's transitive minimums (no downgrades). The kit
         brings EF Core and Npgsql; SQLite stays only to read an earlier release's store once (import-sqlite). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Image decode + web previews (same version as Ocharo Marketing). -->
    <PackageVersion Include="SkiaSharp" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test stack. The kit's harnesses run PostgreSQL in a Testcontainers container (Docker required). -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Testing" Version="10.0.106-beta" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.0.0" />
    <!-- Service tokens with no Identity running: the fake issuer and its token endpoint; same version as the client above. -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Identity.Testing" Version="10.0.30-beta" />
  </ItemGroup>

  <!-- Opt-in local SDK verification; absent from clean checkouts and CI. -->
  <Import Project="$(MSBuildThisFileDirectory).local/backend-sdk.props"
          Condition="Exists('$(MSBuildThisFileDirectory).local/backend-sdk.props')" />
</Project>
