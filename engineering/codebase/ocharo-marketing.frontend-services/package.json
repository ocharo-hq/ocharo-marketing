{
  "name": "ocharomarketing-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Private frontend workspace for OcharoMarketing.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @ocharomarketing/web dev",
    "dev:http": "pnpm --filter @ocharomarketing/web dev:http",
    "typecheck": "pnpm --filter @ocharomarketing/web typecheck",
    "build": "pnpm --filter @ocharomarketing/web build",
    "preview": "pnpm --filter @ocharomarketing/web preview",
    "test": "pnpm --filter @ocharomarketing/web test",
    "format": "pnpm --filter @ocharomarketing/web format",
    "format:check": "pnpm --filter @ocharomarketing/web format:check",
    "lint": "pnpm --filter @ocharomarketing/web lint",
    "deploy": "pnpm build && node scripts/deploy.mjs",
    "build:blog": "pnpm --filter @ocharomarketing/blog build",
    "preview:blog": "pnpm --filter @ocharomarketing/blog preview",
    "dev:editorial": "pnpm --filter @ocharomarketing/editorial dev",
    "build:editorial": "pnpm --filter @ocharomarketing/editorial build",
    "test:editorial": "pnpm --filter @ocharomarketing/editorial test",
    "deploy:editorial": "pnpm build:editorial && node scripts/deploy-editorial.mjs",
    "build:atlas": "pnpm --filter @ocharomarketing/atlas build",
    "preview:atlas": "pnpm --filter @ocharomarketing/atlas preview",
    "build:wear": "pnpm --filter @ocharomarketing/wear build",
    "preview:wear": "pnpm --filter @ocharomarketing/wear preview",
    "build:catalogue": "pnpm --filter @ocharomarketing/catalogue build",
    "preview:catalogue": "pnpm --filter @ocharomarketing/catalogue preview"
  }
}
