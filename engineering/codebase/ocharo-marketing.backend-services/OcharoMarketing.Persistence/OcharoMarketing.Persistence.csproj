<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The PostgreSQL floor (EF Core, Npgsql, snake_case naming) and the bespoke SQL migrator: EF only maps the
         SQL-owned schema. -->
    <PackageReference Include="WoW2.Sdk.Beta.Be" />
    <!-- Reads an earlier release's SQLite store once, for the import-sqlite verb. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcharoMarketing.Application\OcharoMarketing.Application.csproj" />
    <ProjectReference Include="..\OcharoMarketing.Domain\OcharoMarketing.Domain.csproj" />
  </ItemGroup>

  <!-- The `marketing` set ships embedded (logical name "Migrations/NNN-name/Apply.sql"); Dev/ drafts never ship. -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql" Exclude="Migrations\Dev\**\*.sql">
      <LogicalName>Migrations/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
