<Project>

  <!--
    Central Package Management — one version per package for the whole solution.
    Project .csproj files reference packages by name only (no Version attribute).
    https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- wow-two backend SDK (kit): mediator, Result/DomainError, IKeyedEntity, web/problem-details. On nuget.org. -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be" Version="10.0.111-beta" />
    <!-- Sign-in through Ocharo's Identity instance: the BFF (session cookie, OIDC code flow with PKCE, X-Csrf-Token). -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Identity.Client" Version="10.0.30-beta" />
    <!-- WoW2 Files: the contract (Infrastructure's store) and its HTTP client (the host's composition). -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Files.Abstractions" Version="10.0.6-beta" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Files.Client" Version="10.0.6-beta" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET 10 extensions. Floors satisfy the kit's transitive minimums (no downgrades). PostgreSQL, EF Core and
         snake_case naming arrive through the kit. -->
    <!-- Reads an earlier release's SQLite store once, for the import-sqlite verb. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="SkiaSharp" Version="3.119.2" />
    <!-- Test stack. AwesomeAssertions and the fake clock pin the versions the be sdk's testing kit already brings. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Testing" Version="10.0.111-beta" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Testing.Data" Version="10.0.111-beta" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Opt-in local SDK verification; absent from clean checkouts and CI. -->
  <Import Project="$(MSBuildThisFileDirectory).local/backend-sdk.props"
          Condition="Exists('$(MSBuildThisFileDirectory).local/backend-sdk.props')" />
</Project>
