{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "//Settings": "DB_CONNECTION, else a target's or a local run's settings file, holds the connection; no secret here.",
  "DatabaseSettings": {
    "ConnectionString": ""
  },
  "ConnectionStrings": {},
  "Marketing": {
    "EnableLivePublishing": false,
    "DataDirectory": "App_Data",
    "MaximumAssetBytes": 26214400,
    "EnableAccountVerification": false,
    "EnableMetricReads": false,
    "MaximumMetricReadsPerHour": 10,
    "MetricRefreshCooldownSeconds": 60
  }
}
