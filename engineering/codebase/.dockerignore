# Build context = engineering/codebase/ (parent of ocharo-marketing.backend-services + ocharo-marketing.frontend-services).

# Build outputs — restored/rebuilt fresh inside the image
**/bin/
**/obj/
**/dist/
**/node_modules/

# Local SQLite stores — don't ship a dev database into an image layer
**/*.db
**/*.db-shm
**/*.db-wal

# Locally-deployed SPA — the spa stage rebuilds it from source
ocharo-marketing.backend-services/OcharoMarketing.Api/wwwroot/

# IDE / VCS / OS cruft
**/.vs/
**/.idea/
**/.git/
**/*.user
**/.DS_Store
